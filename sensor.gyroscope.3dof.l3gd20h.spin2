#include "sensor.gyroscope.common.spin2h"

CON

    { default I/O configuration - these can be overridden by the parent object }
    ' I2C
    SCL             = 0
    SDA             = 1
    I2C_FREQ        = 1_000_000
    I2C_ADDR        = 0

    ' SPI
    CS              = 0
    SCK             = 1
    MOSI            = 2
    MISO            = 3
    SPI_FREQ        = 1_000_000

    ' Indicate to user apps how many Degrees of Freedom each sub-sensor has
    '   (also imply whether or not it has a particular sensor)
    ACCEL_DOF       = 0
    GYRO_DOF        = 3
    MAG_DOF         = 0
    BARO_DOF        = 0
    DOF             = ACCEL_DOF + GYRO_DOF + MAG_DOF + BARO_DOF

    ' Scales and data rates used during calibration/bias/offset process
    CAL_XL_SCL      = 0
    CAL_G_SCL       = 245
    CAL_M_SCL       = 0
    CAL_XL_DR       = 0
    CAL_G_DR        = 100
    CAL_M_DR        = 0

    ' Axis-specific constants
    X_AXIS          = 0
    Y_AXIS          = 1
    Z_AXIS          = 2
    ALL_AXIS        = 3

    ' High-pass filter modes
    #0, HPF_NORMAL_RES, HPF_REF, HPF_NORMAL, HPF_AUTO_RES

    ' Operation modes
    #0, POWERDOWN, SLEEP, NORMAL

    ' Interrupt pin active states
    #0, INTLVL_LOW, INTLVL_HIGH

    ' Interrupt pin output type
    #0, INT_PP, INT_OD

    ' Gyro data byte order
    #0, LSBFIRST, MSBFIRST

    ' Operation modes
    STANDBY         = 0
    MEASURE         = 1


    ' FIFO operation modes
    #0, BYPASS, FIFO, STREAM, STREAM2FIFO, BYPASS2STREAM, #6, DYN_STREAM, BYPASS2FIFO


    SLAVE_WR        = core.SLAVE_ADDR
    SLAVE_RD        = core.SLAVE_ADDR|1

    DEF_SCL         = 0
    DEF_SDA         = 1
    DEF_HZ          = 100_000
    DEF_ADDR        = 0
    I2C_MAX_FREQ    = core.I2C_MAX_FREQ


VAR

    long _CS
    byte _addr_bits


OBJ

{ SPI? }
#ifdef L3GD20H_SPI
    spi:    "com.spi.10mhz"                     ' SPI engine
#else
{ no, not SPI - default to I2C }
# define L3GD20H_I2C
    i2c:    "com.i2c"                           ' I2C engine
#endif
    core:   "core.con.l3gd20h"                  ' HW-specific constants


PUB null()
' This is not a top-level object


#ifdef L3GD20H_I2C

PUB start(): status
' Start using default I/O configuration
    return startx(SCL, SDA, I2C_FREQ, I2C_ADDR)


PUB startx(SCL_PIN, SDA_PIN, I2C_HZ, ADDR_BITS): status
' Start using custom I/O pins and I2C bus speed
    if ( lookdown(SCL_PIN: 0..63) and lookdown(SDA_PIN: 0..63) )
        if ( status := i2c.init(SCL_PIN, SDA_PIN, I2C_HZ) )
            waitms(1)                           ' wait for device startup
            { promote any non-zero value for ADDR_BITS to '1' }
            _addr_bits := ( ((ADDR_BITS) ? 1 : 0) ) << 1
            if ( dev_id() == core.DEVID_RESP )  ' verify communication with device
                    return status
    ' if this point is reached, something above failed
    ' Double check I/O pin assignments, connections, power
    ' Lastly - make sure you have at least one free core/cog
    return FALSE

#elseifdef L3GD20H_SPI

PUB start(): status
' Start using default I/O configuration
    return startx(CS, SCK, MOSI, MISO, SPI_FREQ)


PUB startx(CS_PIN, SCL_PIN, MOSI_PIN, MISO_PIN, SPI_HZ=1_000_000): status
' Start using custom I/O pins
    if (    lookdown(CS_PIN: 0..63) and lookdown(SCL_PIN: 0..63) and ...
            lookdown(MOSI_PIN: 0..63) and lookdown(MISO_PIN: 0..63) )
        if ( status := spi.init(SCL_PIN, MOSI_PIN, MISO_PIN, core.SPI_MODE, SPI_HZ) )
            _CS := CS_PIN
            waitms(10)
            pinh(_CS)
            if ( dev_id() == core.DEVID_RESP )  ' verify communication with device
                return status
    ' if this point is reached, something above failed
    ' Double check I/O pin assignments, connections, power
    ' Lastly - make sure you have at least one free core/cog
    return FALSE
#endif


PUB stop()
' Stop the driver
#ifdef L3GD20H_I2C
    i2c.deinit()
#elseifdef L3GD20H_SPI
    spi.deinit()
    _CS := 0
#endif


PUB defaults()
' Set factory defaults
{'  This is what _would_ be set:
    blockupdateenabled(FALSE)
    databyteorder(LSBFIRST)
    fifoenabled(FALSE)
    gyroaxisenabled(%111)
    gyro_data_rate(100)
    gyroopmode(POWERDOWN)
    gyroscale(245)
    highpassfilterenabled(FALSE)
    highpassfilterfreq(8_00)
    highpassfiltermode(HPF_NORMAL_RES)
    int1mask(%00)
    int2mask(%0000)
    intactivestate(INTLVL_LOW)
    intoutputtype(INT_PP)
}'  but to save code space, just soft-reset, instead:
    reset()


PUB preset_active()
' Like Defaults(), but
'   * Normal (active) operating mode
    reset()
    gyro_opmode(NORMAL)
    gyro_scale(245)                              ' already set at POR, but this
                                                ' needs to be called to set
                                                ' scaling value hub var


PUB blk_updt_ena(b=-2): c
' Enable block updates
'   Valid values:
'      *FALSE (0): Update gyro data outputs continuously
'       TRUE (-1 or 1): Pause further updates until both MSB and LSB of data have been read
'   Any other value polls the chip and returns the current setting
    c := readreg(core.CTRL4)
    case abs(b)
        0, 1:
            b := (abs(b) & 1) << core.BDU
            b := ((c & core.BDU_MASK) | b)
            writereg(core.CTRL4, b)
        other:
            return (((c >> core.BDU) & 1) == 1)


PUB data_order(bo=-2): c
' Set byte order of gyro data
'   Valid values:
'      *LSBFIRST (0), MSBFIRST (1)
'   Any other value polls the chip and returns the current setting
'   NOTE: Intended only for use when utilizing raw gyro data from GyroData method.
'       GyroDPS expects the data order to be LSBFIRST
    c := readreg(core.CTRL4)
    case bo
        LSBFIRST, MSBFIRST:
            bo <<= core.BLE
            bo := ((c & core.BLE_MASK) | bo)
            writereg(core.CTRL4, bo)
        other:
            return ((c >> core.BLE) & 1)


PUB dev_id(): id
' Read device identification
    return readreg(core.WHO_AM_I)


PUB fifo_ena(f=-2): c
' Enable FIFO for gyro data
'   Valid values:
'      *FALSE (0): FIFO disabled
'       TRUE (-1 or 1): FIFO f
'   Any other value polls the chip and returns the current setting
    c := readreg(core.CTRL5)
    case abs(f)
        0, 1:
            f := (abs(f) & 1) << core.FIFO_EN
            f := ((c & core.FIFO_EN_MASK) | f)
            writereg(core.CTRL5, f)
        other:
            return (((c >> core.FIFO_EN) & 1) == 1)


PUB fifo_empty(): f
' Flag indicating FIFO empty
'   Returns: FALSE (0): FIFO not empty, TRUE(-1): FIFO empty
    f := readreg(core.FIFO_SRC)
    return (((f >> core.EMPTY) & 1) == 1)


PUB fifo_full(): f
' Flag indicating FIFO threshold reached
'   Returns: FALSE (0): lower than threshold level, TRUE(-1): at or higher than threshold level
    f := readreg(core.FIFO_SRC)
    return (((f >> core.FTH) & 1) == 1)


PUB fifo_mode(md=-2): c
' Set FIFO operation mode
'   Valid values:
'      *BYPASS (0)
'       FIFO (1)
'       STREAM (2)
'       STREAM2FIFO (3)
'       BYPASS2STREAM (4)
'       DYN_STREAM (6)
'       BYPASS2FIFO (7)
'   Any other value polls the chip and returns the current setting
    c := readreg(core.FIFO_CTRL)
    case md
        BYPASS, FIFO, STREAM, STREAM2FIFO, BYPASS2STREAM, DYN_STREAM, BYPASS2FIFO:
            md <<= core.FM
            md := ((c & core.FM_MASK) | md)
            writereg(core.FIFO_CTRL, md)
        other:
            return ((c >> core.FM) & core.FM_BITS)


PUB fifo_thresh(thr=-2): c
' Set FIFO threshold level
'   Valid values: 0..31
'   Any other value polls the chip and returns the current setting
    c := readreg(core.FIFO_CTRL)
    case thr
        0..31:
            thr := ((c & core.FTH_MASK) | thr)
            writereg(core.FIFO_CTRL, thr)
        other:
            return (c & core.FTH_BITS)


PUB fifo_nr_unread(): n
' Number of unread samples stored in FIFO
'   Returns: 0 (empty) .. 32
    n := readreg(core.FIFO_SRC)
    return n & core.FSS_BITS


PUB gyro_axis_ena(msk=-2): c
' Enable gyroscope individual axes, by mask
'   Valid values:
'       0: Disable axis, 1: Enable axis
'       Bits %210
'             ZYX (default: %111)
'   Any other value polls the chip and returns the current setting
    c := readreg(core.CTRL1)
    case msk
        %000..%111:
            msk := ((c & core.XYZEN_MASK) | msk)
            writereg(core.CTRL1, msk)
        other:
            return (c & core.XYZEN_BITS)


PUB gyro_bias(x, y, z)
' Read gyroscope calibration offset values
'   x, y, z: pointers to copy offsets to
    long[x] := _gbias[X_AXIS]
    long[y] := _gbias[Y_AXIS]
    long[z] := _gbias[Z_AXIS]


PUB gyro_set_bias(x, y, z)
' Write gyroscope calibration offset values
'   Valid values:
'   -32768..32767
    longmove(@_gbias, @x, 3)


PUB gyro_data(ptr_x, ptr_y, ptr_z) | tmp[2]
' Read gyroscope data
    bytefill(@tmp, 0, 8)
    readreg(core.OUT_X_L, 6, @tmp)

    long[ptr_x] := (tmp.word[X_AXIS] signx 15) - _gbias[X_AXIS]
    long[ptr_y] := (tmp.word[Y_AXIS] signx 15) - _gbias[Y_AXIS]
    long[ptr_z] := (tmp.word[Z_AXIS] signx 15) - _gbias[Z_AXIS]


PUB gyro_data_overrun(): o
' Indicates previously acquired data has been overwritten
'   Returns: TRUE (-1) if data has overrun/been overwritten, FALSE otherwise
    o := readreg(core.STATUS)
    o := (((o >> core.ZYXOR) & 1) == 1)


PUB gyro_data_rate(dr=-2): c
' Set rate of data output, in rate
'   Valid values: *100, 200, 400, 800
'   Any other value polls the chip and returns the current setting
    c := readreg(core.CTRL1)
    case dr
        100, 200, 400, 800:
            dr := lookdownz(dr: 100, 200, 400, 800) << core.DR
            dr := ((c & core.DR_MASK) | dr)
            writereg(core.CTRL1, dr)
        other:
            c := ((c >> core.DR) & core.DR_BITS)
            return lookupz(c: 100, 200, 400, 800)


PUB gyro_data_rdy(): r
' Indicates data is ready
'   Returns: TRUE (-1) if data ready, FALSE otherwise
    r := readreg(core.STATUS)
    return (((r >> core.ZYXDA) & 1) == 1)


PUB gyro_opmode(md=-2): c | tmp_xyz
' Set operation mode
'   Valid values:
'      *POWERDOWN (0): Power down - lowest power state
'       SLEEP (1): Sleep - sensor enabled, but X, Y, Z outputs disabled
'       NORMAL (2): Normal - active operating state
'   Any other value polls the chip and returns the current setting
    c := readreg(core.CTRL1)
    case md
        POWERDOWN:
            md := (c & core.PD_MASK)
        SLEEP:
            md := ((c & core.XYZEN_MASK) | (1 << core.PD))
        NORMAL:
            md := ((c & core.PD_MASK) | (1 << core.PD))
        other:
            tmp_xyz := c & core.XYZEN_BITS
            c := (c >> core.PD) & 1
            case c                      ' check state of power md bit
                0:                              ' power down
                    return POWERDOWN
                1:                              ' normal md
                    if tmp_xyz                  ' if any axes are enabled,
                        return NORMAL           '   chip md is normal
                    else
                        return SLEEP            ' if not, it's sleeping

    writereg(core.CTRL1, md)


PUB gyro_scale(s=-2): c
' Set gyro full-scale range, in degrees per second
'   Valid values: *245, 500, 2000
'   Any other value polls the chip and returns the current setting
'   NOTE: Set and get values are always in degrees per second, despite the availability
'       of radians per second variant data read method
    c := readreg(core.CTRL4)
    case s
        245, 500, 2000:
            s := lookdownz(s: 245, 500, 2000)
            _gres := lookupz(s: 8_750, 17_500, 70_000)
            _gres_rads_sec := lookupz(s: 0_152, 0_305, 1_220)
            _gres_dps_f := lookupz(s: 0.00875, 0.0175, 0.070)
            _gres_rads_sec_f := lookupz(s: 0.000152716, 0.000305433, 0.001221730)
            s := ( (c & core.FS_MASK) | (s << core.FS) )
            writereg(core.CTRL4, s)
        other:
            c := (c >> core.FS) & core.FS_BITS
            return lookupz(c: 245, 500, 2000)


PUB gyro_hpf_ena(hpf=-2): c
' Enable high-pass filter for gyro data
'   Valid values:
'      *FALSE (0): High-pass filter disabled
'       TRUE (-1 or 1): High-pass filter state
'   Any other value polls the chip and returns the current setting
    c := readreg(core.CTRL5)
    case abs(hpf)
        0, 1:
            hpf := (abs(hpf) & 1) << core.HPEN
            hpf := ((c & core.HPEN_MASK) | hpf)
            writereg(core.CTRL5, hpf)
        other:
            return (((c >> core.HPEN) & 1) == 1)


PUB gyro_hpf_freq(f=-2): c
' Set high-pass filter frequency, in centi-Hz
'    Valid values:
'       If ODR=100Hz: *8_00, 4_00, 2_00, 1_00, 0_50, 0_20, 0_10, 0_05, 0_02, 0_01
'       If ODR=200Hz: *15_00, 8_00, 4_00, 2_00, 1_00, 0_50, 0_20, 0_10, 0_05, 0_02
'       If ODR=400Hz: *30_00, 15_00, 8_00, 4_00, 2_00, 1_00, 0_50, 0_20, 0_10, 0_05
'       If ODR=800Hz: *56_00, 30_00, 15_00, 8_00, 4_00, 2_00, 1_00, 0_50, 0_20, 0_10
    c := readreg(core.CTRL2)
    case gyro_data_rate(-2)
        100:
            case f
                8_00, 4_00, 2_00, 1_00, 0_50, 0_20, 0_10, 0_05, 0_02, 0_01:
                    f := lookdownz(f: 8_00, 4_00, 2_00, 1_00, 0_50, 0_20, 0_10, 0_05, ...
                                            0_02, 0_01) << core.HPCF
                other:
                    c := (c >> core.HPCF) & core.HPCF_BITS
                    return lookupz(c: 8_00, 4_00, 2_00, 1_00, 0_50, 0_20, 0_10, 0_05, ...
                                                0_02, 0_01)
        200:
            case f
                15_00, 8_00, 4_00, 2_00, 1_00, 0_50, 0_20, 0_10, 0_05, 0_02:
                    f := lookdownz(f: 15_00, 8_00, 4_00, 2_00, 1_00, 0_50, 0_20, 0_10, ...
                                            0_05, 0_02) << core.HPCF
                other:
                    c := (c >> core.HPCF) & core.HPCF_BITS
                    return lookupz(c: 15_00, 8_00, 4_00, 2_00, 1_00, 0_50, 0_20, 0_10, ...
                                                0_05, 0_02)
        400:
            case f
                30_00, 15_00, 8_00, 4_00, 2_00, 1_00, 0_50, 0_20, 0_10, 0_05:
                    f := lookdownz(f: 30_00, 15_00, 8_00, 4_00, 2_00, 1_00, 0_50, 0_20, ...
                                            0_10, 0_05) << core.HPCF
                other:
                    c := (c >> core.HPCF) & core.HPCF_BITS
                    return lookupz(c: 30_00, 15_00, 8_00, 4_00, 2_00, 1_00, 0_50, 0_20, ...
                                                0_10, 0_05)
        800:
            case f
                56_00, 30_00, 15_00, 8_00, 4_00, 2_00, 1_00, 0_50, 0_20, 0_10:
                    f := lookdownz(f: 56_00, 30_00, 15_00, 8_00, 4_00, 2_00, 1_00, 0_50, ...
                                            0_20, 0_10) << core.HPCF
                other:
                    c := (c >> core.HPCF) & core.HPCF_BITS
                    return lookupz(c: 56_00, 30_00, 15_00, 8_00, 4_00, 2_00, 1_00, ...
                                                0_50, 0_20, 0_10)

    f := ((c & core.HPCF_MASK) | f)
    writereg(core.CTRL2, f)


PUB gyro_hpf_mode(md=-2): c
' Set data output high pass filter mode
'   Valid values:
'      *HPF_NORMAL_RES (0): Normal mode (reset reading HP_RESET_FILTER) XXX - clarify/expand
'       HPF_REF (1): Reference signal for filtering
'       HPF_NORMAL (2): Normal
'       HPF_AUTO_RES (3): Autoreset on interrupt
'   Any other value polls the chip and returns the current setting
    c := readreg(core.CTRL2)
    case md
        HPF_NORMAL_RES, HPF_REF, HPF_NORMAL, HPF_AUTO_RES:
            md <<= core.HPM
            md := ((c & core.HPM_MASK) | md)
            writereg(core.CTRL2, md)
        other:
            return ((c >> core.HPM) & core.HPM_BITS)


PUB int1_mask(msk=-2): c
' Set interrupt mask for INT1 pin
'   Valid values:
'       Bit 10   10
'           ||   ||
'    Range %00..%11
'       Bit 1: Interrupt enable (*0: Disable, 1: Enable)
'       Bit 0: Boot status (*0: Disable, 1: Enable)
    c := readreg(core.CTRL3)
    case msk
        %00..%11:
            msk <<= core.INT1
            msk := ((c & core.INT1_MASK) | msk)
            writereg(core.CTRL3, msk)
        other:
            return ((c >> core.INT1) & core.INT1_BITS)


PUB int2_mask(msk=-2): c
' Set interrupt/function mask for INT2 pin
'   Valid values:
'       Bit 3210   3210
'           ||||   ||||
'    Range %0000..%1111 (default value: %0000)
'       Bit 3: Data ready
'       Bit 2: FIFO watermark
'       Bit 1: FIFO overrun
'       Bit 0: FIFO empty
    c := readreg(core.CTRL3)
    case msk
        %0000..%1111:
            msk := ((c & core.INT2_MASK) | msk)
            writereg(core.CTRL3, msk)
        other:
            return (c & core.INT2_BITS)


PUB int_polarity(p=-2): c
' Set active state for interrupts
'   Valid values: *INTLVL_LOW (0), INTLVL_HIGH (1)
'   Any other value polls the chip and returns the current setting
    c := readreg(core.CTRL3)
    case p
        INTLVL_LOW, INTLVL_HIGH:
            p := ((p ^ 1) & 1) << core.H_LACTIVE
            p := ((c & core.H_LACTIVE_MASK) | p)
            writereg(core.CTRL3, p)
        other:
            return (((c >> core.H_LACTIVE) ^ 1) & 1)


PUB int_outp_type(t=-2): c
' Set interrupt pin output type
'   Valid values:
'      *INT_PP (0): Push-pull
'       INT_OD (1): Open-drain
'   Any other value polls the chip and returns the current setting
    c := readreg(core.CTRL3)
    case t
        INT_PP, INT_OD:
            t := t << core.PP_OD
            t := ((c & core.PP_OD_MASK) | t)
            writereg(core.CTRL3, t)
        other:
            return ((c >> core.PP_OD) & 1)


PUB reset() | tmp
' Perform soft-reset
    tmp := (1 << core.SW_RES)
    writereg(core.LOW_ODR, tmp)


PUB temp_data(): t
' Read device temperature
    return readreg(core.OUT_TEMP)


PRI readreg(reg_nr, len=1, p_dest=0): v | cmd_pkt
' Read nr_bytes from the slave device into ptr_buff
    case reg_nr                                 ' validate reg #
        $0F, $20..$27, $2E..$39:
            p_dest := @v
        core.OUT_X_L:                           ' If reading from data regs,
#ifdef L3GD20H_SPI
            reg_nr |= core.MS_SPI               '   set multi-byte read mode
#elseifdef L3GD20H_I2C
            reg_nr |= core.MS_I2C               '   same, for I2C
#endif
        other:
            return

#ifdef L3GD20H_SPI
    reg_nr |= core.R
    ' request read from reg_nr
    pinl(_CS)
        spi.wr_byte(reg_nr)
        spi.rdblock_lsbf(p_dest, len)
    pinh(_CS)
#elseifdef L3GD20H_I2C
    cmd_pkt.byte[0] := (SLAVE_WR | _addr_bits)
    cmd_pkt.byte[1] := reg_nr
    i2c.start()
        i2c.wrblock_lsbf(@cmd_pkt, 2)
        i2c.start()
        i2c.wr_byte(SLAVE_RD | _addr_bits)
        i2c.rdblock_lsbf(p_dest, len, TRUE)
    i2c.stop()
#endif


PRI writereg(reg_nr, val) | cmd_pkt
' Write num_bytes to the slave device from the address stored in ptr_buff
    case reg_nr                                 ' validate reg #
        $20..$25, $2E, $30, $32..$39:
#ifdef L3GD20H_SPI
            pinl(_CS)
            spi.wr_byte(reg_nr)
            spi.wrblock_lsbf(@val, 1)
            pinh(_CS)
#elseifdef L3GD20H_I2C
            cmd_pkt.byte[0] := (SLAVE_WR | _addr_bits)
            cmd_pkt.byte[1] := reg_nr
            i2c.start()
            i2c.wrblock_lsbf(@cmd_pkt, 2)
            i2c.wrblock_lsbf(@val, 1)
            i2c.stop()
#endif
        other:
            return


DAT
